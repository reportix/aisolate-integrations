      "id": "6d1f7a10-0004-4c3e-9a10-a15010000004",
      "name": "Ask AIsolate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// One item per evidence entry; the answer rides on each, so a filter, a sheet or a database node keeps it.\n// An answer without evidence (\"I don't know\") is one item with empty evidence fields.\n// Evidence is provenance only: its id, the tool that read, what it read, and how many rows. Never the rows.\n// provenance is the gate: all_sourced, or has_unsourced / has_mismatch for a person to check first.\nconst a = $input.first().json;\nconst p = a.provenance ?? {};\nconst base = {\n  answer: a.answer,\n  dont_know: a.dont_know,\n  provenance: p.status ?? null,\n  sourced: p.sourced ?? null,\n  computed: p.computed ?? null,\n  unsourced: p.unsourced ?? null,\n  mismatch: p.mismatch ?? null,\n  revision: a.revision,\n  trace_id: a.trace_id,\n};\nconst evidence = a.evidence ?? [];\nif (evidence.length === 0) {\n  return [{ json: { ...base, evidence_id: null, source: null, name: null, rows: 0 } }];\n}\nreturn evidence.map((e) => ({\n  json: { ...base, evidence_id: e.id, source: e.source, name: e.name, rows: e.rows },\n}));\n"
      },
      "id": "6d1f7a10-0005-4c3e-9a10-a15010000005",
      "name": "Evidence table",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    }
